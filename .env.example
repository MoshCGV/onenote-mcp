# Configuration reference for onenote-mcp.
#
# Easiest: run `node dist/index.js configure --client-id ... --tenant ...`, which writes
# ~/.onenote-mcp/config.json. The variables below override that file. Put them in the "env"
# block of your MCP client config; this file is not loaded automatically.

# Application (client) ID of your Microsoft Entra app registration (README step 1).
ONENOTE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Tenant: your directory (tenant) ID or company domain for work accounts, "consumers" for
# personal accounts, or "common" / "organizations".
ONENOTE_TENANT_ID=common

# Sign-in method: "browser" (default, authorization code + PKCE) or "device" (device code).
# ONENOTE_AUTH_FLOW=browser

# Print the sign-in link instead of opening a browser (headless machines).
# ONENOTE_NO_BROWSER=1

# Delegated permissions requested at sign-in (default Notes.ReadWrite).
# Notes.ReadWrite.All reaches notebooks shared with you and team notebooks.
# ONENOTE_SCOPES=Notes.ReadWrite.All

# OneNote location under Microsoft Graph (default me/onenote).
# Team/SharePoint notebooks: groups/{group-id}/onenote or sites/{site-id}/onenote
# ONENOTE_BASE_PATH=me/onenote

# Where settings and the sign-in token cache live (default ~/.onenote-mcp, owner-only).
# ONENOTE_CACHE_DIR=~/.onenote-mcp

# Where onenote_download_resources saves files (default ~/Downloads/OneNote MCP).
# ONENOTE_DOWNLOAD_DIR=~/Downloads/OneNote MCP

# Image sizing for what the model sees.
# ONENOTE_MAX_IMAGE_PX=1568          # longest edge for single-image zoom views
# ONENOTE_OVERVIEW_IMAGE_PX=1024     # longest edge for images inside a page read
# ONENOTE_MAX_IMAGES=6               # images returned inline per page read
# ONENOTE_MAX_RESPONSE_IMAGE_BYTES=700000   # image bytes per tool response

# Testing only: skip MSAL and use a pre-obtained Graph token (expires after ~1 hour).
# ONENOTE_ACCESS_TOKEN=eyJ0eXAi...
